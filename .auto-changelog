{
    "template": "keepachangelog",
    "unreleased": true,
    "commitLimit": false,
    "ignoreCommitPattern": ".*(CHANGELOG|README).*",
    "sortCommits": "date",
    "breakingPattern": "BREAKING[ -]CHANGE:|^[a-z]+([(][^)]*[)])?!:",
    "replaceText": {
        "^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)([(][^)]*[)])?!?: ": ""
    }
}
